# Copy to .env and adjust. Never commit .env.

# --- server ---
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=debug

# --- database ---
DATABASE_URL=postgres://marketplace:marketplace@localhost:5432/marketplace?sslmode=disable

# --- redis ---
REDIS_URL=redis://localhost:6379/0

# --- auth ---
# 32+ bytes. Generate: openssl rand -base64 48
JWT_SIGNING_KEY=dev-only-do-not-use-in-any-deployed-environment
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# --- otp ---
# In development, OTP codes are logged instead of sent. Never enable in prod.
OTP_DEV_ECHO=true
OTP_TTL=5m

# --- object storage (MinIO in dev, S3 in me-central-1 in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=me-central-1
S3_BUCKET=marketplace-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- money / locale defaults ---
DEFAULT_CURRENCY=AED
DEFAULT_LOCALE=en
DEFAULT_TIMEZONE=Asia/Dubai

# --- media pipeline (Phase 2) ---
# Base URL the stub transcoder writes playlist URLs against.
MEDIA_CDN_BASE_URL=http://localhost:9000/marketplace-media
# `stub` synthesises renditions without an encoder. Refused when APP_ENV=production.
TRANSCODE_VENDOR=stub
# `stub` skips the ffprobe binary. Leave empty to use ffprobe from PATH.
FFPROBE_BINARY=stub

# --- moderation ---
# Without a key the text layer is a stub that approves everything.
# Required when APP_ENV=production.
ANTHROPIC_API_KEY=
# Opus 5 by default. Haiku 4.5 is ~5x cheaper at volume, but its minimum
# cacheable prefix is 4096 tokens against Opus's 512 — check the policy prompt
# still crosses that line before switching, or caching silently stops.
MODERATION_MODEL=claude-opus-5

# --- search (indexed from day one; still not on the read path) ---
# Leave empty to run without OpenSearch; the indexer becomes a no-op.
# Phase 4 ranks against Postgres, not this — see docs/PHASE-4-RANKING-AND-SOCIAL.md §7.
#   docker compose --profile search up -d
OPENSEARCH_URL=
OPENSEARCH_INDEX=reels

# --- analytics warehouse (Phase 4) ---
# Leave empty to keep engagement events in Postgres, which is correct for
# development and for a launch district and wrong at city scale.
#   docker compose --profile analytics up -d && make clickhouse-schema
CLICKHOUSE_URL=
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_TABLE=reel_events
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
# Writes every event to both stores. Set during the cutover so the numbers can be
# compared before anything depends on the new one.
CLICKHOUSE_TEE=false

# --- feed service (cmd/feed) ---
FEED_HTTP_ADDR=:8081
