<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hand-maintained: tools/gen-ios-strings.sh converts <string> resources only.
  Keep in step with the <plurals> of the same name in androidApp res/values*/strings.xml.
-->
<plist version="1.0">
<dict>
	<key>meals_near_count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@kitchens@</string>
		<key>kitchens</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld kitchen delivers to you</string>
			<key>other</key>
			<string>%1$lld kitchens deliver to you</string>
		</dict>
	</dict>
	<key>meals_near_place</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@kitchens@</string>
		<key>kitchens</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld kitchen delivers to %2$@</string>
			<key>other</key>
			<string>%1$lld kitchens deliver to %2$@</string>
		</dict>
	</dict>
</dict>
</plist>
