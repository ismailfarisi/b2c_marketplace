    <!--
        Arabic has six plural categories where English has two, and Android
        supports all of them. Only `one` and `other` differ in meaning for these
        phrasings — "منذ دقيقة" versus "منذ %d دقيقة" — but `zero`, `two`, `few`
        and `many` are declared because leaving them out makes Android fall back
        to `other`, which produces "منذ 2 دقيقة" where Arabic wants a dual form.
    -->
    <plurals name="ago_minutes">
        <item quantity="one">نُشر منذ دقيقة</item>
        <item quantity="two">نُشر منذ دقيقتين</item>
        <item quantity="few">نُشر منذ %d دقائق</item>
        <item quantity="many">نُشر منذ %d دقيقة</item>
        <item quantity="other">نُشر منذ %d دقيقة</item>
    </plurals>
