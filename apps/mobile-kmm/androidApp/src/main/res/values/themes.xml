<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Ghee paper, the meals canvas. Meals is the first tab, so a cream window
      background is what a cold start should show; the video feed paints its own
      black surface when it opens.
    -->
    <style name="Theme.Marketplace" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ghee_paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
