<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: the bowl on a Chilli Red disc over ghee paper. -->
    <style name="Theme.Marketplace" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ghee_paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/ghee_paper</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
</resources>
