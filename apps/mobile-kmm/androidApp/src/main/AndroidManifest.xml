<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Meal and delivery updates. Asked for after sign-in, not at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Coarse, not fine.

      The feed filters by service-area containment, and a district is enough to
      decide whether a kitchen delivers to you. Asking for precise location for
      that is a permission prompt people decline, and a declined prompt on the
      product's front door is worse than a slightly larger radius.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Pinning a delivery address: asked only when the customer taps "Pin my
         current location", so the driver gets the door, not the district. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
      The recorder.

      Asked for at the Sell tab, not at launch. A camera prompt on first open is
      the single most declined permission in a consumer app, and this one only
      matters to the fraction of viewers who are also sellers.

      RECORD_AUDIO is here because a walkaround with no engine note is a worse
      listing — but the recorder treats a denial as mute rather than as a
      failure, so a seller who refuses it still publishes.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".MarketplaceApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Marketplace">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.Marketplace">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App Links: meals pages on the web open the same screen here. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${webHost}" />
                <data android:pathPrefix="/en/kitchens/" />
                <data android:pathPrefix="/ar/kitchens/" />
                <data android:pathPrefix="/en/subscriptions" />
                <data android:pathPrefix="/ar/subscriptions" />
                <data android:pathPrefix="/en/rotation" />
                <data android:pathPrefix="/ar/rotation" />
            </intent-filter>
        </activity>
        <!-- Started from MarketplaceApp only when a DSN is built in. -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />

        <service
            android:name=".push.PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
