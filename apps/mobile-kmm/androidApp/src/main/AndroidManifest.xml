<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      Coarse, not fine.

      The feed filters by service-area containment, and a district is enough to
      decide whether a kitchen delivers to you. Asking for precise location for
      that is a permission prompt people decline, and a declined prompt on the
      product's front door is worse than a slightly larger radius.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      The recorder.

      Asked for at the Sell tab, not at launch. A camera prompt on first open is
      the single most declined permission in a consumer app, and this one only
      matters to the fraction of viewers who are also sellers.

      RECORD_AUDIO is here because a walkaround with no engine note is a worse
      listing — but the recorder treats a denial as mute rather than as a
      failure, so a seller who refuses it still publishes.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".MarketplaceApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Marketplace">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.Marketplace">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
