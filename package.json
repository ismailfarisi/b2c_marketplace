{
  "name": "b2c-marketplace",
  "private": true,
  "version": "0.0.0",
  "description": "Video-first local marketplace for the GCC — monorepo root",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @marketplace/web",
    "dev:mobile": "npm run start --workspace @marketplace/mobile",
    "build:web": "npm run build --workspace @marketplace/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "gen:ts": "orval --config api/orval.config.ts",
    "gen:check": "node scripts/check-generated.mjs",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "orval": "^7.3.0",
    "typescript": "^5.7.2"
  }
}
